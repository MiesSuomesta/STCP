mainmenu "STCP native P2P"

source "Kconfig.zephyr"

menu "STCP P2P"

config P2P_BENCH_HOST
    string "Default P2P peer host"
    default "192.168.1.20"

config P2P_BENCH_PORT
    string "Default P2P peer port"
    default "19010"

config P2P_BENCH_PAYLOAD_SIZE
    int "Default P2P benchmark payload size"
    default 4096
    range 1 65536

config P2P_BENCH_TOTAL_BYTES
    int "Default P2P benchmark total bytes"
    default 1048576
    range 1 2147483647

config P2P_BENCH_TIMEOUT_MS
    int "Default P2P operation timeout"
    default 30000
    range 1000 600000

config P2P_BENCH_WORKER_STACK_SIZE
    int "P2P benchmark worker thread stack size"
    default 8192
    range 4096 24576

config P2P_BENCH_WORKER_PRIORITY
    int "P2P benchmark worker thread priority"
    default 5
    range 0 15

endmenu
