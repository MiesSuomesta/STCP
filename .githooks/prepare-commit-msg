#!/bin/sh

# Benchmark matrix is attached only when explicitly requested.
if [ "${COMMIT_WITH_MATRIX:-0}" != "1" ]; then
    exit 0
fi

MSG_FILE="$1"

SDK="${STCP_SDK_V4:-$HOME/SDK/v4}"
STCP="${STCP_V4_ROOT:-$HOME/STCP/STCPv4}"

GEN="$SDK/tools/benchmark-matrix.py"
RESULTS="$SDK/robot-results"

OUT_MD="$STCP/BENCHMARK-MATRIX.md"
OUT_TXT="$STCP/BENCHMARK-MATRIX.txt"
OUT_JSON="$STCP/benchmark-matrix.json"
BULK="$SDK/benchmark-results/bulk/latest.json"

if [ ! -x "$GEN" ]; then
    echo "[benchmark-matrix] WARN: generator missing: $GEN" >&2
    exit 0
fi

if [ -f "$BULK" ]; then
    "$GEN" \
        --results "$RESULTS" \
        --output-md "$OUT_MD" \
        --output-txt "$OUT_TXT" \
        --output-json "$OUT_JSON" \
        --bulk "$BULK" ||
        {
            echo "[benchmark-matrix] WARN: generation failed" >&2
            exit 0
        }
else
    "$GEN" \
        --results "$RESULTS" \
        --output-md "$OUT_MD" \
        --output-txt "$OUT_TXT" \
        --output-json "$OUT_JSON" ||
        {
            echo "[benchmark-matrix] WARN: generation failed" >&2
            exit 0
        }
fi

if [ -s "$OUT_TXT" ]; then
    {
        printf '\n\n'
        printf '%s\n' '--- STCP BENCHMARK MATRIX ---'
        cat "$OUT_TXT"
        printf '%s\n' '--- END STCP BENCHMARK MATRIX ---'
    } >> "$MSG_FILE"

    echo "[benchmark-matrix] added to commit message"
fi

exit 0
