#!/bin/bash

MSG_FILE="$1"
LIMIT_MB=17
LIMIT=$((LIMIT_MB * 1024 * 1024))
rc=0

{
    echo "#"
    echo "# Staged files check, max size is $LIMIT_MB MiB..."

    while IFS= read -r -d '' file; do
        size=$(git cat-file -s ":$file" 2>/dev/null) || continue

        if (( size >= LIMIT )); then
            echo "#     $file ... OVER LIMIT ($size bytes)"
            rc=1
        else
            echo "#     $file ... OK ($size bytes)"
        fi
    done < <(git diff --cached --name-only --diff-filter=ACMR -z)

    if [ "${GIT_COMMIT_AS_I_SAY:-0}" = "1" ]; then
        echo "# Size gate override active: GIT_COMMIT_AS_I_SAY=1"
    elif (( rc != 0 )); then
        echo "# WARNING: file(s) >= $LIMIT_MB MiB; pre-commit will reject the commit."
        echo "# Override intentionally with: GIT_COMMIT_AS_I_SAY=1 git commit"
    else
        echo "# Staged file size check OK."
    fi
    echo "#"
} >> "$MSG_FILE"

exit 0
