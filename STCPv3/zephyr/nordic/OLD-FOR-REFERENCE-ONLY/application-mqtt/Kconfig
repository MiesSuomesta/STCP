mainmenu "STCPv2 MQTT application"

source "Kconfig.zephyr"

#
# Some NCS/Zephyr revisions carry the MQTT custom-transport code in mqtt.h /
# mqtt_transport.c but do not expose a selectable Kconfig symbol in the same
# way as upstream main.  Define/augment it here so the public structures and
# enum values guarded by CONFIG_MQTT_LIB_CUSTOM_TRANSPORT are compiled in.
#
config MQTT_LIB_CUSTOM_TRANSPORT
    bool "Enable MQTT custom transport"
    depends on MQTT_LIB
    default y
    help
      Enable Zephyr MQTT custom transport support.  The STCP MQTT application
      uses this to bind the Zephyr MQTT protocol engine to AF_STCP.

menu "STCP MQTT"

config STCP_MQTT_BROKER_IPV4
    string "MQTT broker IPv4"
    default "192.168.1.20"

config STCP_MQTT_BROKER_PORT
    int "MQTT broker port"
    default 1883
    range 1 65535

config STCP_MQTT_TOPIC
    string "Publish topic"
    default "stcp/demo"

config STCP_MQTT_CLIENT_ID
    string "MQTT client ID"
    default "stcp-zephyr"

config STCP_MQTT_PAYLOAD
    string "Publish payload"
    default "hello from Zephyr over STCP"

config STCP_MQTT_PUBLISH_INTERVAL_MS
    int "Publish interval ms"
    default 10000
    range 1000 3600000

config STCP_MQTT_RECONNECT_DELAY_MS
    int "Reconnect delay ms"
    default 3000
    range 100 60000

endmenu
