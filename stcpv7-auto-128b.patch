+/// Estimate frame compressibility with four 32-byte slices (128 bytes total).
+/// A fixed L1 probe keeps input size constant; thresholds are heuristic.
+/// Returns None to send the original bytes without compression.
+pub fn auto_sample_level(src: &[u8]) -> Option<CompressionLevel> {
+    const CHUNK: usize = 32;
+    const SAMPLE: usize = CHUNK * 4;
+    if src.len() < SAMPLE {
+        return None;
+    }
+    let last = src.len() - CHUNK;
+    // Avoid overlapping slices on short payloads.
+    let offsets = if src.len() < 224 {
+        [0, 32, 64, 96]
+    } else {
+        [0, last / 3, (last * 2) / 3, last]
+    };
+    let mut sample = [0u8; SAMPLE];
+    for (i, offset) in offsets.iter().enumerate() {
+        sample[i * CHUNK..(i + 1) * CHUNK]
+            .copy_from_slice(&src[*offset..*offset + CHUNK]);
+    }
+    let compressed_len = compress_block(&sample, CompressionLevel::VeryFast).ok()?.len();
+    // Tiny probes include LZ4 token/length overhead; tune with real traffic.
+    if compressed_len >= 126 {
+        None
+    } else if compressed_len >= 109 {
+        Some(CompressionLevel::VeryFast)
+    } else if compressed_len >= 77 {
+        Some(CompressionLevel::Fast)
+    } else if compressed_len >= 39 {
+        Some(CompressionLevel::Default)
+    } else if compressed_len >= 13 {
+        Some(CompressionLevel::High)
+    } else {
+        Some(CompressionLevel::VeryHigh)
     }
 }
 
